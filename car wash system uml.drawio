        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam handwritten false\nskinparam monochrome false\nskinparam packageStyle rect\nskinparam shadowing true\nskinparam class {\n    BackgroundColor White\n    ArrowColor #2563EB\n    BorderColor #1E40AF\n}\n\n&#39; ==========================================\n&#39; 1. CLASS DIAGRAM (Core Architecture)\n&#39; ==========================================\n\npackage \&quot;User Management\&quot; {\n    class Customer {\n        +String customerId\n        +String fullName\n        +String phoneNumber\n        +String email\n        +registerVehicle()\n        +createBooking()\n    }\n\n    class Attendant {\n        +String staffId\n        +String name\n        +String assignedBay\n        +scanTicket(ticketCode)\n        +updateWashProgress()\n    }\n}\n\npackage \&quot;Operations &amp; Booking\&quot; {\n    class Vehicle {\n        +String licensePlate\n        +String makeModel\n        +String category // Sedan, SUV, Truck\n    }\n\n    class WashPackage {\n        +String packageId\n        +String name // Express Wash, Full Detail\n        +double price\n        +int durationMinutes\n    }\n\n    class Booking {\n        +String bookingId\n        +String ticketCode // QR Code\n        +DateTime scheduledTime\n        +String currentStatus // Booked, In Wash, Completed\n        +double totalCost\n    }\n\n    class WashBay {\n        +String bayId\n        +String bayType // Automatic, Manual Bay\n        +String status // Available, Occupied, Maintenance\n    }\n\n    class Payment {\n        +String transactionId\n        +double amount\n        +String paymentMethod // Mobile Money, Card, Cash\n        +String status // Paid, Pending\n    }\n}\n\n&#39; Relationships\nCustomer \&quot;1\&quot; *-- \&quot;1..*\&quot; Vehicle : owns\nCustomer \&quot;1\&quot; -- \&quot;0..*\&quot; Booking : places\nBooking \&quot;1\&quot; -- \&quot;1\&quot; Vehicle : for\nBooking \&quot;1\&quot; -- \&quot;1..*\&quot; WashPackage : includes\nBooking \&quot;1\&quot; -- \&quot;1\&quot; Payment : requires\nBooking \&quot;0..1\&quot; -- \&quot;1\&quot; WashBay : assigned to\nAttendant \&quot;1\&quot; -- \&quot;0..1\&quot; WashBay : operates\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="PK1I1nYqJ0CmSjT_beyz-1">
